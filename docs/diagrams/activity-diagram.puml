@startuml mental-pieces-actividades
' Mental Pieces — Diagrama de actividades: ciclo de vida de una cita (2026-10-18)
' Basado en AppointmentsService, AppointmentLifecycleService y ClinicalService (reglas reales).
' Tres carriles: lo que hace el paciente, lo que valida el sistema y lo que hace el psicólogo.

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #4A5A50
skinparam ArrowThickness 1.3
skinparam activity {
  BackgroundColor #FFFDF9
  BorderColor #365B45
  BorderThickness 1.3
  DiamondBackgroundColor #FFF6E0
  DiamondBorderColor #B5832B
  StartColor #294637
  EndColor #294637
}
skinparam swimlane {
  BorderColor #C9C1B5
  BorderThickness 1.5
  TitleFontSize 16
  TitleFontStyle bold
}
skinparam note {
  BackgroundColor #FFFDF9
  BorderColor #DDD5CA
  FontSize 12
}

title Mental Pieces — Ciclo de vida de una cita

' ============================ 1. Agendar ============================
|#EEF4EF|Paciente|
start
:Abrir «Agendar cita»;

repeat
  :Elegir psicólogo y fecha;
  |#F4F1EC|Sistema|
  :Calcular horarios libres
  (bloques de 60 min dentro de la disponibilidad,
  sin choques y sin horas ya pasadas);
repeat while (¿Hay horarios libres?) is (no) not (sí)

repeat
  |Paciente|
  :Elegir horario y confirmar;
  |Sistema|
  :Validar la reserva en una transacción:
  • psicólogo activo
  • hora futura (America/Bogota)
  • dentro de su disponibilidad
  • máximo 4 citas futuras
  • sin choque para psicólogo ni paciente;
  backward :Mostrar el motivo del rechazo;
repeat while (¿Reserva válida?) is (no) not (sí)

#CFE3D3:Crear la cita en estado **PROGRAMADA**;

' ============================ 2. Antes de la cita ============================
|Paciente|
:Revisar la cita en «Mis citas» → Próximas;
if (¿Cambia la cita antes de que empiece?) then (no)
else (sí)
  if (¿Reagendar o cancelar?) then (reagendar)
    :Elegir nueva fecha y horario;
    :Confirmar el cambio;
    |Sistema|
    :Validar el nuevo horario
    (mismas reglas que al agendar:
    si falla, la cita no cambia);
    #CFE3D3:Actualizar la cita
    (sigue **PROGRAMADA**);
  else (cancelar)
    |Paciente|
    :Confirmar «Sí, cancelar cita»;
    |Sistema|
    :Verificar que la cita es suya
    y todavía no ha comenzado;
    #F3D6D0:Estado **CANCELADA**
    (libera el horario);
    stop
  endif
endif

' ============================ 3. Cierre de la cita ============================
|Sistema|
:Termina la hora de la cita
(la cita aparece como «Pendiente de cierre»);

|#EDF4FA|Psicólogo|
:Revisar su agenda → Historial;
:Marcar «Realizada» o «Inasistencia»;
|Sistema|
:Verificar: cita propia, PROGRAMADA y ya terminada
(transacción Serializable);
if (¿Qué marcó el psicólogo?) then (inasistencia)
  |Sistema|
  #F6E1C9:Estado **INASISTENCIA**
  + registro de auditoría;
else (realizada)
  #CFE3D3:Estado **REALIZADA**
  + registro de auditoría;

  ' ------------------------ 4. Nota clínica (opcional) ------------------------
  |Psicólogo|
  if (¿Registrar nota clínica?) then (sí)
    :Abrir el paciente en «Mis pacientes»;
    |Sistema|
    if (¿Relación clínica activa?) then (sí)
    else (no)
      #F3D6D0:Responder 404 genérico
      (no revela si el paciente existe);
      stop
    endif
    |Psicólogo|
    :Escribir la nota (1–10 000 caracteres)
    y vincularla a la cita realizada;
    |Sistema|
    :Guardar la nota (una principal por cita)
    + auditoría sin contenido clínico;
  else (no)
  endif
endif

|Sistema|
:La cita alimenta las alertas de seguimiento
(inactividad e inasistencias que ven
el psicólogo y el administrador);
stop

@enduml
