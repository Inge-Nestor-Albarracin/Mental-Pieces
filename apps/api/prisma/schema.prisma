datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

enum UserRole {
  PATIENT
  STAFF
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile Patient?
  staffProfile   StaffProfile?

  psychologistAvailabilities PsychologistAvailability[]
  psychologistAppointments Appointment[] @relation("PsychologistAppointments")
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  mrn         String    @unique
  fullName    String?
  birthDate   DateTime?
  gender      Gender?
  genderOther String?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
  appointments Appointment[]
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model PsychologistAvailability {
  id             String   @id @default(cuid())
  psychologistId String
  dayOfWeek      WeekDay
  startMinute    Int
  endMinute      Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([psychologistId, dayOfWeek, startMinute, endMinute])
  @@index([psychologistId, dayOfWeek, isActive])
}
enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String
  psychologistId String
  appointmentDate String
  startMinute    Int
  endMinute      Int
  status         AppointmentStatus @default(SCHEDULED)
  cancelledAt    DateTime?
  cancellationReason String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  patient Patient @relation(
    fields: [patientId],
    references: [id],
    onDelete: Restrict
  )

  psychologist User @relation(
    "PsychologistAppointments",
    fields: [psychologistId],
    references: [id],
    onDelete: Restrict
  )

  @@index([patientId, appointmentDate])
  @@index([psychologistId, appointmentDate, status])
}