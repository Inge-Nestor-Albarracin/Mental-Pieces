datasource db {
  provider = "postgresql"
}

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

enum UserRole {
  PATIENT
  STAFF
  ADMIN
  PSYCHOLOGIST
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum LegalDocumentKind {
  DATA_PROCESSING_POLICY
}

// What the person authorised. Account management only: consent for health data
// and informed consent for care are separate, clinical flows.
enum ConsentPurpose {
  ACCOUNT_DATA_PROCESSING
}

enum ConsentSource {
  PATIENT_REGISTRATION
  EXISTING_ACCOUNT
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile Patient?
  staffProfile   StaffProfile?

  psychologistAvailabilities PsychologistAvailability[]
  psychologistAppointments   Appointment[]              @relation("PsychologistAppointments")

  careRelationships  CareRelationship[]      @relation("CarePsychologist")
  clinicalNotes      ClinicalSessionNote[]   @relation("NoteAuthor")
  auditLogs          AuditLog[]
  notifications      Notification[]
  dataConsents       DataProcessingConsent[]
  pushSubscriptions  PushSubscription[]
  bookedAppointments Appointment[]           @relation("AppointmentBookedBy")
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  mrn         String    @unique
  fullName    String?
  birthDate   DateTime?
  gender      Gender?
  genderOther String?
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Optional 24 h email reminders: off until the patient turns them on themselves.
  // The timestamp records when the choice was last changed (on or off).
  emailRemindersEnabled   Boolean   @default(false)
  emailRemindersUpdatedAt DateTime?

  user              User                  @relation(fields: [userId], references: [id])
  appointments      Appointment[]
  careRelationships CareRelationship[]
  clinicalNotes     ClinicalSessionNote[]
}

model StaffProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  position  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model PsychologistAvailability {
  id             String   @id @default(cuid())
  psychologistId String
  dayOfWeek      WeekDay
  startMinute    Int
  endMinute      Int
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist User @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@unique([psychologistId, dayOfWeek, startMinute, endMinute])
  @@index([psychologistId, dayOfWeek, isActive])
}

model Appointment {
  id                 String            @id @default(cuid())
  patientId          String
  psychologistId     String
  appointmentDate    String
  startMinute        Int
  endMinute          Int
  status             AppointmentStatus @default(SCHEDULED)
  cancelledAt        DateTime?
  cancellationReason String?
  // Staff member who booked on the patient's behalf; null when the patient booked.
  bookedByUserId     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  psychologist  User                 @relation("PsychologistAppointments", fields: [psychologistId], references: [id], onDelete: Restrict)
  bookedBy      User?                @relation("AppointmentBookedBy", fields: [bookedByUserId], references: [id], onDelete: Restrict)
  clinicalNote  ClinicalSessionNote?
  notifications Notification[]

  @@index([patientId, appointmentDate])
  @@index([psychologistId, appointmentDate, status])
}

model CareRelationship {
  id             String    @id @default(cuid())
  patientId      String
  psychologistId String
  isActive       Boolean   @default(true)
  assignedAt     DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  psychologist User                  @relation("CarePsychologist", fields: [psychologistId], references: [id], onDelete: Restrict)
  notes        ClinicalSessionNote[]

  // One durable relationship per pair, including after revocation.
  @@unique([patientId, psychologistId])
  @@index([psychologistId, isActive, patientId])
}

model ClinicalSessionNote {
  id             String   @id @default(cuid())
  patientId      String
  psychologistId String
  // A principal note per completed appointment; unlinked notes remain supported.
  appointmentId  String?  @unique
  content        String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Restrict)
  psychologist     User             @relation("NoteAuthor", fields: [psychologistId], references: [id], onDelete: Restrict)
  careRelationship CareRelationship @relation(fields: [patientId, psychologistId], references: [patientId, psychologistId], onDelete: Restrict)
  appointment      Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([psychologistId, patientId, createdAt, id])
}

enum ClinicalAuditAction {
  CARE_RELATIONSHIP_CREATED
  CARE_RELATIONSHIP_ENDED
  CLINICAL_NOTE_CREATED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
}

model AuditLog {
  id           String              @id @default(cuid())
  actorUserId  String
  action       ClinicalAuditAction
  resourceType String
  resourceId   String
  createdAt    DateTime            @default(now())

  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt])
  @@index([actorUserId, createdAt])
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  APPOINTMENT_RESCHEDULE
  // Push only: tells staff (reception) that an appointment was booked.
  STAFF_NEW_BOOKING
}

enum NotificationChannel {
  EMAIL
  PUSH
}

// ACCEPTED = the SMTP server accepted the message. It does NOT prove delivery to the
// inbox: the message can still bounce later.
enum NotificationStatus {
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  CANCELLED
}

// Transactional outbox: rows are written in the same transaction as the appointment
// change; a separate cron process sends them later. Never stores message bodies.
model Notification {
  id                String              @id @default(cuid())
  type              NotificationType
  channel           NotificationChannel @default(EMAIL)
  recipientUserId   String
  appointmentId     String
  // Slot the message talks about; re-checked against the live appointment before sending.
  appointmentDate   String
  startMinute       Int
  status            NotificationStatus  @default(PENDING)
  scheduledFor      DateTime
  // One logical message per key: makes enqueueing idempotent across retries.
  idempotencyKey    String              @unique
  attempts          Int                 @default(0)
  lastAttemptAt     DateTime?
  // Claim lease for the processor; an expired lease means the run was interrupted.
  lockedUntil       DateTime?
  acceptedAt        DateTime?
  providerMessageId String?
  // Sanitized code only (e.g. SMTP_550, ETIMEDOUT, STALE); never message text or addresses.
  errorCode         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  recipient   User        @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([status, scheduledFor])
  @@index([appointmentId, status])
  @@index([recipientUserId, acceptedAt])
}

// Published legal text, one row per version, never edited after publication
// (database trigger). Published with the private CLI after legal review.
model LegalDocument {
  id                   String            @id @default(cuid())
  kind                 LegalDocumentKind
  version              String
  title                String
  body                 String
  // Hex SHA-256 of the UTF-8 body: identifies exactly the text that was accepted.
  sha256               String
  // false for editorial changes that do not need a new authorisation.
  requiresReacceptance Boolean           @default(true)
  publishedAt          DateTime          @default(now())
  createdAt            DateTime          @default(now())

  consents DataProcessingConsent[]

  @@unique([kind, version])
  @@index([kind, publishedAt])
}

// Evidence that a user accepted a published policy. Append-only (database
// trigger); the time is set by the server. No passwords, tokens or clinical data.
model DataProcessingConsent {
  id              String         @id @default(cuid())
  userId          String
  documentId      String
  purpose         ConsentPurpose
  source          ConsentSource
  // Copies of the accepted version, kept with the evidence.
  documentVersion String
  documentSha256  String
  acceptedAt      DateTime       @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  document LegalDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([userId, documentId, purpose])
  @@index([userId, acceptedAt])
}

// Web Push subscription of one browser/device. Created only by the signed-in user
// (POST /push/subscriptions); removed at logout or when the push service says it is gone.
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  // Push service URL (allow-listed hosts only). Unique: if another account signs in on
  // the same browser, the subscription moves to that account.
  endpoint      String    @unique
  p256dh        String
  auth          String
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
