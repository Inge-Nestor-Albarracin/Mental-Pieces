DATABASE_URL=
PORT=3001
JWT_SECRET=
JWT_EXPIRES_IN=15m
# Optional security settings (see docs/security.md)
# CORS_ORIGINS=http://localhost:3000
# TRUST_PROXY=0

# Email notifications (docs/notifications-email.md). Used ONLY by the cron script
# dist/src/cli/notifications.js, kept in a private env file outside the repository.
# The API process does not need these variables. Never commit real values.
# NOTIFICATIONS_ENABLED=false
# NOTIFICATIONS_RECIPIENT_ALLOWLIST=
# NOTIFICATIONS_TIMEZONE=America/Bogota
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=notificaciones@mentalpieces.site
# SMTP_PASSWORD=
# SMTP_FROM=notificaciones@mentalpieces.site

# Web Push notifications (docs/notificaciones-push-y-recepcion.md). Needed by BOTH the
# API process (sends right after a booking change) and the cron script (retries and
# 24 h reminders). Generate the keys once: npx web-push generate-vapid-keys
# Never commit real values; the private key must never reach the frontend.
# PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:paulasarmientopsicologia@gmail.com

# Cron → API trigger (Hostinger cron jobs do NOT receive the app's environment
# variables). The cron runs every 5 minutes:
#   curl -fsS -X POST -H "X-Cron-Secret: <secret>" https://api.mentalpieces.site/internal/notifications/run
# 32+ random characters; unset = endpoint disabled (404).
# NOTIFICATIONS_CRON_SECRET=

# Database TLS. Remote connections are ALWAYS encrypted. Paste Supabase's
# "SSL certificate" (Database settings, PEM) to also verify the server certificate.
# DATABASE_SSL_CA=
